{
    "name": "MODYFIRE - Group 2: Growth & Onboarding (Marketing Enhanced)",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "signup",
                "options": {}
            },
            "name": "Signup Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                150
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json[\"body\"][\"auth_token\"] || $json[\"headers\"][\"x-n8n-auth\"] }}",
                            "value2": "={{ $env[\"AUTH_SECRET_TOKEN\"] }}"
                        }
                    ]
                }
            },
            "name": "Bouncer 1: Signup",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                300,
                150
            ]
        },
        {
            "parameters": {
                "operation": "appendOrUpdate",
                "sheetId": "YOUR_SHEET_ID",
                "range": "A:E",
                "options": {}
            },
            "name": "Log Signup to Sheets",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 1,
            "position": [
                500,
                150
            ]
        },
        {
            "parameters": {
                "amount": 24,
                "unit": "hours"
            },
            "name": "Wait 24h",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1,
            "position": [
                700,
                150
            ]
        },
        {
            "parameters": {
                "dataType": "string",
                "value1": "={{ $json[\"body\"][\"tier\"] }}",
                "rules": {
                    "rules": [
                        {
                            "value2": "student",
                            "output": 0
                        },
                        {
                            "value2": "professor",
                            "output": 1
                        },
                        {
                            "value2": "educator",
                            "output": 1
                        }
                    ]
                },
                "fallbackOutput": 2
            },
            "name": "Tier Switch",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 1,
            "position": [
                900,
                150
            ]
        },
        {
            "parameters": {
                "subject": "🔥 Improve your grades in 60 seconds (Video)",
                "message": "Hey,\n\nI made a quick video showing how to hack your finals studying.\n\nWatch Kai explain it on TikTok: [Link]\n\nCheers,\nTeam Modyfire",
                "toEmail": "={{ $json[\"email\"] }}"
            },
            "name": "Email: Student Kai Video",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 1,
            "position": [
                1100,
                50
            ]
        },
        {
            "parameters": {
                "subject": "Case Study: Reducing Grading Time by 40%",
                "message": "Professor,\n\nWe have prepared a case study on how University of X used Modyfire to automate lecture summaries.\n\nDownload PDF: [Link]\n\nBest,\nKai from Modyfire",
                "toEmail": "={{ $json[\"email\"] }}"
            },
            "name": "Email: Educator Case Study",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 1,
            "position": [
                1100,
                250
            ]
        },
        {
            "parameters": {
                "subject": "Welcome to Modyfire!",
                "message": "Hi there,\n\nWelcome to the platform. Here are your getting started docs.\n\n[Link]",
                "toEmail": "={{ $json[\"email\"] }}"
            },
            "name": "Email: General Welcome",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 1,
            "position": [
                1100,
                450
            ]
        },
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 9 * * *"
                        }
                    ]
                }
            },
            "name": "Daily Lead Gen Trigger",
            "type": "n8n-nodes-base.cron",
            "typeVersion": 1,
            "position": [
                100,
                650
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM potential_leads WHERE status = 'PENDING' LIMIT 15"
            },
            "name": "Fetch Leads from PG",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                300,
                650
            ]
        },
        {
            "parameters": {
                "model": "gemini-1.5-flash",
                "prompt": "=Write a personalized cold email pitch to {{ $json[\"name\"] }} from MODYFIRE. Mention their recent video/post about {{ $json[\"topic\"] }}. Keep it under 100 words. Persona: Kai, The Architect."
            },
            "name": "Gemini AI Pitch (Kai)",
            "type": "n8n-nodes-base.googleGemini",
            "typeVersion": 1,
            "position": [
                500,
                650
            ]
        },
        {
            "parameters": {
                "url": "https://api.instantly.ai/api/v1/lead/add",
                "method": "POST",
                "headerParametersUi": {
                    "parameter": [
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_INSTANTLY_API_KEY"
                        }
                    ]
                },
                "bodyParametersUi": {
                    "parameter": [
                        {
                            "name": "email",
                            "value": "={{ $json[\"email\"] }}"
                        },
                        {
                            "name": "first_name",
                            "value": "={{ $json[\"first_name\"] }}"
                        },
                        {
                            "name": "custom_variables",
                            "value": "={ \"pitch\": \"{{ $json[\"output\"] }}\" }"
                        },
                        {
                            "name": "campaign_id",
                            "value": "YOUR_CAMPAIGN_ID"
                        }
                    ]
                }
            },
            "name": "Add to Instantly.ai",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 1,
            "position": [
                700,
                650
            ]
        }
    ],
    "connections": {
        "Signup Webhook": {
            "main": [
                [
                    {
                        "node": "Bouncer 1: Signup",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Bouncer 1: Signup": {
            "main": [
                [
                    {
                        "node": "Log Signup to Sheets",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Log Signup to Sheets": {
            "main": [
                [
                    {
                        "node": "Wait 24h",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Wait 24h": {
            "main": [
                [
                    {
                        "node": "Tier Switch",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Tier Switch": {
            "main": [
                [
                    {
                        "node": "Email: Student Kai Video",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Email: Educator Case Study",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Email: General Welcome",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Daily Lead Gen Trigger": {
            "main": [
                [
                    {
                        "node": "Fetch Leads from PG",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Leads from PG": {
            "main": [
                [
                    {
                        "node": "Gemini AI Pitch (Kai)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Gemini AI Pitch (Kai)": {
            "main": [
                [
                    {
                        "node": "Add to Instantly.ai",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}