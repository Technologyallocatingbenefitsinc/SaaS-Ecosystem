{
    "name": "MODYFIRE - Group 4: Security & Support (AI Agent)",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "error-webhook",
                "options": {}
            },
            "name": "Self-Healing Hook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                150
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json[\"body\"][\"auth_token\"] || $json[\"headers\"][\"x-n8n-auth\"] }}",
                            "value2": "={{ $env[\"AUTH_SECRET_TOKEN\"] }}"
                        }
                    ]
                }
            },
            "name": "Bouncer 1: Health",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                300,
                150
            ]
        },
        {
            "parameters": {
                "operation": "append",
                "sheetId": "your-google-sheet-id",
                "range": "Health!A:Z",
                "fieldsUI": {
                    "values": [
                        {
                            "name": "Time",
                            "value": "={{ $now }}"
                        },
                        {
                            "name": "Flow",
                            "value": "={{ $json[\"body\"][\"workflow_name\"] }}"
                        },
                        {
                            "name": "Node",
                            "value": "={{ $json[\"body\"][\"node\"] }}"
                        },
                        {
                            "name": "Message",
                            "value": "={{ $json[\"body\"][\"message\"] }}"
                        }
                    ]
                }
            },
            "name": "Log Error to Health",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 1,
            "position": [
                500,
                150
            ]
        },
        {
            "parameters": {
                "authentication": "oAuth2",
                "resource": "message",
                "operation": "send",
                "phoneNumberId": "YOUR_META_PHONE_ID",
                "recipientPhoneNumber": "YOUR_WHATSAPP_NUMBER",
                "messageType": "text",
                "text": "=🚨 CRITICAL ERROR: Flow '{{ $json[\"body\"][\"workflow_name\"] }}' failed. Automated healing attempted."
            },
            "name": "WhatsApp Alert",
            "type": "n8n-nodes-base.whatsApp",
            "typeVersion": 1,
            "position": [
                700,
                150
            ]
        },
        {
            "parameters": {
                "filters": {
                    "labelIds": [
                        "INBOX"
                    ],
                    "q": "is:unread (Refund OR Help OR Support)"
                }
            },
            "name": "Watch Help Inbox",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2,
            "position": [
                100,
                350
            ]
        },
        {
            "parameters": {
                "model": "gemini-1.5-flash",
                "prompt": "=You are Kai, a helpful support architect for Modyfire. Draft a polite, helpful reply to this customer email. Resolve their issue if simple, or promise a human will check it. Keep it under 50 words. Email body: {{ $json[\"snippet\"] }}"
            },
            "name": "Kai AI Support Agent",
            "type": "n8n-nodes-base.googleGemini",
            "typeVersion": 1,
            "position": [
                300,
                350
            ]
        },
        {
            "parameters": {
                "operation": "reply",
                "messageId": "={{ $json[\"messageId\"] }}",
                "text": "={{ $json[\"output\"] }}",
                "options": {
                    "appendSignature": true
                }
            },
            "name": "Send AI Reply",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2,
            "position": [
                500,
                350
            ]
        },
        {
            "parameters": {
                "authentication": "oAuth2",
                "resource": "message",
                "operation": "send",
                "phoneNumberId": "YOUR_META_PHONE_ID",
                "recipientPhoneNumber": "YOUR_WHATSAPP_NUMBER",
                "messageType": "text",
                "text": "=💬 SUPPORT: AI Agent 'Kai' replied to {{ $json[\"to\"] }}: '{{ $json[\"output\"] }}'"
            },
            "name": "WhatsApp Log",
            "type": "n8n-nodes-base.whatsApp",
            "typeVersion": 1,
            "position": [
                700,
                350
            ]
        }
    ],
    "connections": {
        "Self-Healing Hook": {
            "main": [
                [
                    {
                        "node": "Bouncer 1: Health",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Bouncer 1: Health": {
            "main": [
                [
                    {
                        "node": "Log Error to Health",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Log Error to Health": {
            "main": [
                [
                    {
                        "node": "WhatsApp Alert",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Watch Help Inbox": {
            "main": [
                [
                    {
                        "node": "Kai AI Support Agent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Kai AI Support Agent": {
            "main": [
                [
                    {
                        "node": "Send AI Reply",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send AI Reply": {
            "main": [
                [
                    {
                        "node": "WhatsApp Log",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}